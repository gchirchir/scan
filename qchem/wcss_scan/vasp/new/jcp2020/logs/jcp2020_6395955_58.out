def cmd_report(_a):
    """Self-contained report: all generated tables pasted in (no \\input), then pdflatex (three passes)."""
    import subprocess
    n_done, n_tot = cmd_table(_a)
    rd = lambda n: open(os.path.join(RES, n)).read()
    box = lambda t: "\\resizebox{\\textwidth}{!}{%\n" + t + "}\n"
    dev = [float(r["abs_dev_recomputed_vs_printed"]) for r in csv.DictReader(open(os.path.join(RES,
                                                                                      "jcp2020_table2_check.csv")))]
    chk = list(csv.DictReader(open(os.path.join(RES, "jcp2020_table2_check.csv"))))
    dj = max(float(r["abs_dev_recomputed_vs_printed"]) for r in chk if r["stat"] != "MARE")
    mare = sorted(((float(r["abs_dev_recomputed_vs_printed"]), r) for r in chk if r["stat"] == "MARE"), key=lambda t: t[0])
    out = [(d, r) for d, r in mare if d > 0.5]
    inl = max(d for d, r in mare if d <= 0.5)
    maxdev = (f"{dj:.2f}~J\\,m$^{{-2}}$ for all ME and MAE entries (rounding of the printed $\\sigma$ to two "
              f"decimals); MARE within {inl:.2f}\\% (the same rounding, amplified by the division by "
              f"$\\gamma^{{\\rm exp}}$ and by its effect on the Wulff fractions)" +
              ("".join(f", except {r['kind']}/{r['group']}/{r['functional']} ({d:.2f}\\%)" for d, r in out)))
    ns, nf, nl = existing_results(ref_table1())
    gtex, ngate = gate_table()
    ltex, nlat, nlattot = lattice_table()
    st = status_rows()
    status = "; ".join(f"{n}: {d}/{t} runs" for n, d, t in st) + f"; Table~I: {n_done}/{n_tot} entries"
    t1 = []
    for s in FACETS:
        t1.append("\\begin{table}[htbp]\\centering\n\\caption{Surface energies (J\\,m$^{-2}$) of the " + s +
                  " metals (Table~I of Ref.~\\cite{Patra2020}). This work: self-consistent PySCF, Eq.~(\\ref{eq:sigma}); "
                  "DC-SCAN by Eq.~(\\ref{eq:dcscan}). \\textcolor{red}{JCP}: Ref.~\\cite{Patra2020}; "
                  "\\textcolor{red}{Exp.}: experiment for the most stable facet as quoted there.}\\label{tab:t1" + s +
                  "}\n\\scriptsize\\setlength{\\tabcolsep}{3.5pt}\n" + box(rd(f"jcp2020_table1_{s}.tex")) + "\\end{table}\n")
    figs = []
    for n, cap in (("jcp2020_fig1.pdf", "Surface energy against the number of layers (Fig.~1 of Ref.~\\cite{Patra2020}), "
                    "Q2D-GGA and DC-SCAN."),
                   ("jcp2020_fig2.pdf", "Surface density difference $\\Delta n(z)=n_{\\rm surf,l}+n_{\\rm surf,r}-n_{\\rm bulk}$ "
                    "(Fig.~2 of Ref.~\\cite{Patra2020}).")):
        if os.path.exists(os.path.join(FIG, n)):
            figs.append("\\begin{figure}[htbp]\\centering\\includegraphics[width=0.8\\textwidth]{../figures/" + n +
                        "}\\caption{" + cap + "}\\end{figure}")
    tex = (REPORT_TEX.replace("@DATE@", time.strftime("%Y-%m-%d %H:%M")).replace("@MAXDEV@", maxdev)
           .replace("@EXISTSIGMA@", box(rd("jcp2020_existing_sigma.tex")))
           .replace("@EXISTLAT@", rd("jcp2020_existing_lattice.tex"))
           .replace("@GATETAB@", gtex).replace("@NGATE@", str(ngate))
           .replace("@LATTAB@", ltex).replace("@NLAT@", str(nlat)).replace("@NLATTOT@", str(nlattot))
           .replace("@EXISTSRC@", f"{ns} self-consistent PRL-protocol surface energies, {nf} first-order SCAN/DC-SCAN "
                    f"values, {nl} lattice constants")
           .replace("@TAB2CHECK@", box(rd("jcp2020_table2_check.tex"))).replace("@WULFF@", box(rd("jcp2020_wulff_ref.tex")))
           .replace("@STATUS@", status).replace("@TABLE1@", "\n".join(t1))
           .replace("@TABLE2@", box(rd("jcp2020_table2.tex")))
           .replace("@FIGURES@", "\n".join(figs) if figs else "Figures 1 and 2: no runs yet."))
    path = os.path.join(RES, "jcp2020_report.tex")
    open(path, "w").write(tex)
    for _ in range(3):
        r = subprocess.run(["pdflatex", "-interaction=nonstopmode", "jcp2020_report.tex"], cwd=RES,
                           capture_output=True, text=True, errors="replace")
    log = open(os.path.join(RES, "jcp2020_report.log"), errors="replace").read()
    print(f"{path} -> jcp2020_report.pdf: errors {log.count(chr(10) + '!')}, undefined "
          f"{log.lower().count('undefined')}, overfull {log.count('Overfull')}")


def delta_n(m, facet, f, layers):
    """Fig. 2 construction (adapted from script 22 delta_n): z/d0 from the broken-bond centre half a spacing outside
    the first plane; n(z) = plane average x cell area; left surface = mirror image; bulk profile phased so that
    plane k of the slab matches the bulk plane of the same stacking position."""
    tag = surf_tag(m, facet, f, layers)
    d = json.load(open(os.path.join(RES, tag + ".json")))
    b = np.load(os.path.join(RES, tag + "_bulk.npz"))
    s = np.load(os.path.join(RES, tag + "_slab.npz"))
    g = d["geometry"]
    d0 = float(np.mean(g["spacings_ang"]))
    zc = float(g["zplanes_ang"][0]) - 0.5 * d0
    zs, ns = s["z_ang"], s["n_z"]
    period = zs[1] - zs[0] + zs[-1]
    zb, nb = b["z_ang"], b["n_z"]
    pb = zb[1] - zb[0] + zb[-1]
    zb0 = float(g["zfirst_in_bulk_cell_ang"]) - 0.5 * d0     # same stacking position in the bulk cell
    area = g["area_ang2"] / BOHR_ANG ** 2
    x = np.linspace(-2.5, 1.0, 351)
    z = -x * d0

    def per(zq, zz, nn, p):
        return np.interp(np.mod(zq, p), np.append(zz, p), np.append(nn, nn[0]))

    n_r = per(zc + z, zs, ns, period)
    n_l = per(zc - z, zs, ns, period)
    n_b = per(zb0 + z, zb, nb, pb)
    return x, area * (n_r + n_l - n_b)


def cmd_figures(a):
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    os.makedirs(FIG, exist_ok=True)
    fig, axs = plt.subplots(2, 1, figsize=(5, 6), sharex=True)
    for ax, m in zip(axs, FIG1):
        for fc, col in zip(FACETS[METALS[m][0]], ("C0", "C1", "C2")):
            for f, ls in (("Q2D-GGA", "-o"), ("DC-SCAN", "--s")):
                xs, ys = [], []
                for n in FIG1[m]:
                    v = None
                    for L in (n, n + 1):
                        p = os.path.join(RES, surf_tag(m, fc, "SCAN" if f == "DC-SCAN" else f, L) + ".json")
                        if os.path.exists(p):
                            dd = json.load(open(p))
                            v = dd.get("sigma_dcscan_J_m2" if f == "DC-SCAN" else "sigma_J_m2")
                    if v is not None:
                        xs.append(n); ys.append(v)
                if xs:
                    ax.plot(xs, ys, ls, color=col, ms=4, label=f"({fc}) {f}")
        ax.set_ylabel(r"$\sigma$ (J m$^{-2}$)")
        ax.set_title(f"{m} ({METALS[m][0]})", fontsize=10)
        ax.legend(fontsize=7, ncol=2)
    axs[-1].set_xlabel("number of layers $N$")
    fig.tight_layout()
    fig.savefig(os.path.join(FIG, "jcp2020_fig1.pdf"))
    fig, axs = plt.subplots(1, 3, figsize=(11, 3.4), sharey=True)
    for ax, (st, (ms, fc)) in zip(axs, FIG2.items()):
        for m in ms:
            try:
                x, dn = delta_n(m, fc, a.functional, 13)
            except (FileNotFoundError, KeyError):
                continue
            ax.plot(x, dn, label=f"{m}({fc})")
        ax.axhline(0, color="k", lw=0.5)
        ax.set_xlabel("$z/d_0$")
        ax.set_title(f"{st}, {a.functional} density", fontsize=10)
        ax.legend(fontsize=8)
    axs[0].set_ylabel(r"$\Delta n(z)$ (bohr$^{-1}$)")
    fig.tight_layout()
    fig.savefig(os.path.join(FIG, "jcp2020_fig2.pdf"))
    print("figures/jcp2020_fig1.pdf, figures/jcp2020_fig2.pdf written (missing runs are left out)")


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    def common(q):
        q.add_argument("--system", choices=list(METALS), required=True)
        q.add_argument("--functional", choices=FUNCS + EXTRA, required=True)
        q.add_argument("--cutoff", type=float, default=None, help="Ha (default: 3d 300, Al 80, others 150)")
        q.add_argument("--sigma", type=float, default=0.05, help="Gaussian smearing (eV); paper: 0.05")
        q.add_argument("--max-cycle", type=int, default=200)
        q.add_argument("--kerker-alpha", type=float, default=0.3)
        q.add_argument("--kerker-q0", type=float, default=0.8)
        q.add_argument("--kerker-hist", type=int, default=12)
        q.add_argument("--no-spin", action="store_true", help="Fe/Co non-magnetic (paper: spin-polarised)")

    g = sub.add_parser("geometry")
    g.add_argument("--system", choices=list(METALS), required=True)
    g.add_argument("--facet", default=None)
    g.add_argument("--layers", type=int, default=13)
    q = sub.add_parser("gate")
    common(q)
    q = sub.add_parser("lattice")
    common(q)
    q.add_argument("--k", type=int, default=12, help="k mesh per direction (hcp: k x k x k/(c/a))")
    q.add_argument("--a-center", type=float, default=None,
                   help="centre of the +-5%% grid (Angstrom; default: experimental a); used to repeat a scan whose "
                        "minimum fell near the edge")
    q = sub.add_parser("surface")
    common(q)
    q.add_argument("--facet", required=True)
    q.add_argument("--layers", type=int, default=13, help="atomic planes (paper: 13)")
    q.add_argument("--vacuum", type=float, default=12.0, help="Angstrom (paper: > 20)")
    q.add_argument("--kdens", type=float, default=33.0,
                   help="k points per direction = round(kdens/|a_i|) (Angstrom); 33 = 12x12 for fcc(111) Pt")
    q.add_argument("--kxy", type=int, default=None, help="fixed in-plane k mesh (overrides --kdens; paper: 16)")
    q.add_argument("--kz", type=int, default=None, help="bulk k_z (default: from --kdens)")
    q.add_argument("--a", type=float, default=None, help="lattice constant (Angstrom), overrides --a-source")
    q.add_argument("--a-source", choices=["own", "exp"], default="own")
    sub.add_parser("tasks")
    sub.add_parser("table")
    sub.add_parser("report")
    q = sub.add_parser("figures")
    q.add_argument("--functional", default="PBEsol", help="density used for Fig. 2")
    a = p.parse_args()
    dict(geometry=cmd_geometry, lattice=cmd_lattice, surface=cmd_surface, tasks=cmd_tasks, table=cmd_table,
         figures=cmd_figures, report=cmd_report, gate=cmd_gate)[a.cmd](a)


if __name__ == "__main__":
    main()
